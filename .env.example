POSTGRES_USER=autocore
POSTGRES_PASSWORD=cambia_esta_password
POSTGRES_DB=autocore_reservas
SECRET_KEY=cambia_esto_por_una_clave_larga_y_aleatoria

# Solo producción (docker-compose.prod.yml): dominio público SIN https://
# Ej.: convite.autocore.es — su DNS debe apuntar ya a la IP del servidor.
DOMINIO=convite.tudominio.es

# URLs públicas (para OAuth de Google y CORS). En local, déjalas así.
BACKEND_PUBLIC_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Credenciales OAuth de Google Cloud Console (ver INTEGRACION_N8N.md /
# resumen de la fase 4 para la guía paso a paso). Sin ellas, todo lo demás
# de la app funciona igual — solo "Conectar Google Calendar" queda inactivo.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
